\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A log loader clearing piles at a millyard infeed deck. Our work targets autonomous grasp selection for this task using only depth-derived point clouds.}}{6}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:mill}{{1}{6}{A log loader clearing piles at a millyard infeed deck. Our work targets autonomous grasp selection for this task using only depth-derived point clouds}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Coordinate frames used to compute alignment ($\alpha $) and stability ($\varsigma $). The alignment score measures parallelism between the grapple jaw axis $\hat  {y}_g$ and the log length axis $\hat  {y}_\ell $; stability measures the grapple's levelness via $\hat  {z}_g^\top \hat  {z}_w$.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:grasp_geometry}{{2}{6}{Coordinate frames used to compute alignment ($\alpha $) and stability ($\varsigma $). The alignment score measures parallelism between the grapple jaw axis $\hat {y}_g$ and the log length axis $\hat {y}_\ell $; stability measures the grapple's levelness via $\hat {z}_g^\top \hat {z}_w$}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces PPO training curves (mean episode return vs.\ iteration, 20-iteration rolling average). Diamond markers indicate the checkpoint selected for evaluation. All from-scratch RL variants improve per-grasp reward but fail to achieve full clearing. BC$\to $RL reaches the highest return while maintaining near-complete clearing; performance degrades after $\sim $500 iterations, motivating early stopping.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:reward_curves}{{3}{6}{PPO training curves (mean episode return vs.\ iteration, 20-iteration rolling average). Diamond markers indicate the checkpoint selected for evaluation. All from-scratch RL variants improve per-grasp reward but fail to achieve full clearing. BC$\to $RL reaches the highest return while maintaining near-complete clearing; performance degrades after $\sim $500 iterations, motivating early stopping}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The BC$\to $RL pipeline. (a)~The PointNet encoder and actor MLP are trained end-to-end on expert demonstrations with MSE loss. (b)~The encoder is frozen and the actor MLP is fine-tuned with PPO alongside a state-based asymmetric critic. (c)~At inference the critic is discarded; the encoder and actor run deterministically.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:bcrl_pipeline}{{4}{7}{The BC$\to $RL pipeline. (a)~The PointNet encoder and actor MLP are trained end-to-end on expert demonstrations with MSE loss. (b)~The encoder is frozen and the actor MLP is fine-tuned with PPO alongside a state-based asymmetric critic. (c)~At inference the critic is discarded; the encoder and actor run deterministically}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The grasp-and-remove crane environment. From left to right: parallelized training environments in Isaac Sim, each containing a log loader crane above a rack of 200 logs in randomized configurations; a single environment showing the relevant coordinate frames and the action-space bounding box (wireframe); the crane link structure; the passive joints and grapple yaw angle. At each decision step the policy selects a grasp target within the action bounds, and a finite-state-machine controller executes the pick sequence.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:environment}{{5}{7}{The grasp-and-remove crane environment. From left to right: parallelized training environments in Isaac Sim, each containing a log loader crane above a rack of 200 logs in randomized configurations; a single environment showing the relevant coordinate frames and the action-space bounding box (wireframe); the crane link structure; the passive joints and grapple yaw angle. At each decision step the policy selects a grasp target within the action bounds, and a finite-state-machine controller executes the pick sequence}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Observation pipeline for a single grasp: RGB, raw depth, 3D back-projection in the crane base frame, and FPS-downsampled point cloud with the predicted grasp target and action-space bounds (dashed box).}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:pcd_pipeline}{{6}{7}{Observation pipeline for a single grasp: RGB, raw depth, 3D back-projection in the crane base frame, and FPS-downsampled point cloud with the predicted grasp target and action-space bounds (dashed box)}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Clearing progression: fraction of 200-log pile cleared vs.\ grasp attempt number (mean $\pm $ std over 100 episodes). RL plateaus at $\sim $53\% while BC, BC+RL, and the heuristic all approach full clearing.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:clearing_curves}{{7}{7}{Clearing progression: fraction of 200-log pile cleared vs.\ grasp attempt number (mean $\pm $ std over 100 episodes). RL plateaus at $\sim $53\% while BC, BC+RL, and the heuristic all approach full clearing}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces BC+RL training sensitivity. Mean episode return vs.\ PPO iteration for four configurations varying encoder freezing and initial policy noise $\sigma _0$. Only the frozen-encoder, low-noise configuration ($\sigma _0 = 0.05$) sustains performance; all other variants collapse during training.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:bcrl_ablation}{{8}{8}{BC+RL training sensitivity. Mean episode return vs.\ PPO iteration for four configurations varying encoder freezing and initial policy noise $\sigma _0$. Only the frozen-encoder, low-noise configuration ($\sigma _0 = 0.05$) sustains performance; all other variants collapse during training}{figure.caption.11}{}}
