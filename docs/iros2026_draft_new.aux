\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Observation pipeline at three episode stages. Each row: (a)~RGB, (b)~depth, (c)~segmented depth, (d)~3D back-projection, (e)~FPS point cloud with predicted grasp target (green~=~hit, red~=~miss). Top: dense pile; middle: partially cleared; bottom: sparse endgame.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pcd_pipeline}{{6}{8}{Observation pipeline at three episode stages. Each row: (a)~RGB, (b)~depth, (c)~segmented depth, (d)~3D back-projection, (e)~FPS point cloud with predicted grasp target (green~=~hit, red~=~miss). Top: dense pile; middle: partially cleared; bottom: sparse endgame}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Evaluation results across 100 episodes with randomized 200-log pile configurations (mean $\pm $ std). The heuristic uses privileged pose state. RL variants use a symmetric actor-critic (shared encoder provides auxiliary gradient); BC variants use a PointNet encoder with identical architecture; BC$\to $RL uses an asymmetric actor-critic (frozen BC encoder for actor, state-based MLP critic). RL fails regardless of observation type; for BC, raw PCD matches or exceeds segmented PCD across all metrics.}}{8}{table.caption.8}\protected@file@percent }
\newlabel{tab:results}{{II}{8}{Evaluation results across 100 episodes with randomized 200-log pile configurations (mean $\pm $ std). The heuristic uses privileged pose state. RL variants use a symmetric actor-critic (shared encoder provides auxiliary gradient); BC variants use a PointNet encoder with identical architecture; BC$\to $RL uses an asymmetric actor-critic (frozen BC encoder for actor, state-based MLP critic). RL fails regardless of observation type; for BC, raw PCD matches or exceeds segmented PCD across all metrics}{table.caption.8}{}}
