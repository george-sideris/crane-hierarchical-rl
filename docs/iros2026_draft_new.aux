\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces PPO training curves. Mean episode reward (sum of per-grasp rewards $r = g \cdot \alpha \cdot s$ over a 200-log clearing episode) vs.\ PPO iteration. Each iteration collects $4 N_{\text  {env}}$ grasp cycles; flat segments occur when no episode has terminated since the last update. All three from-scratch RL variants (Pose, Seg.\ PCD, Raw PCD) improve per-grasp reward but fail to achieve full pile clearing (Table~\ref {tab:rl_ablation}). BC$\to $RL initializes from the trained BC policy and reaches the highest episode reward while maintaining near-complete clearing.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:reward_curves}{{2}{6}{PPO training curves. Mean episode reward (sum of per-grasp rewards $r = g \cdot \alpha \cdot s$ over a 200-log clearing episode) vs.\ PPO iteration. Each iteration collects $4 N_{\text {env}}$ grasp cycles; flat segments occur when no episode has terminated since the last update. All three from-scratch RL variants (Pose, Seg.\ PCD, Raw PCD) improve per-grasp reward but fail to achieve full pile clearing (Table~\ref {tab:rl_ablation}). BC$\to $RL initializes from the trained BC policy and reaches the highest episode reward while maintaining near-complete clearing}{figure.caption.4}{}}
\newlabel{sec:reward}{{\mbox  {V-C}}{6}{Reinforcement Learning}{equation.13}{}}
