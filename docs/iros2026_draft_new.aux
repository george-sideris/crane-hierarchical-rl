\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Generalization under pile variation (mean $\pm $ std over 100 episodes). Each episode samples a random pile: log count uniform in $[20, 200]$, grid dimensions ($15$--$25$ columns, $10$--$20$ layers), lateral and vertical spacing ($\pm 5$--$15$\% of nominal), randomized layer offsets ($\pm 5$\,cm), and per-log placement jitter ($\pm 4$\,cm lateral, $\pm 2$\,cm vertical).}}{9}{table.caption.11}\protected@file@percent }
\newlabel{tab:robustness}{{III}{9}{Generalization under pile variation (mean $\pm $ std over 100 episodes). Each episode samples a random pile: log count uniform in $[20, 200]$, grid dimensions ($15$--$25$ columns, $10$--$20$ layers), lateral and vertical spacing ($\pm 5$--$15$\% of nominal), randomized layer offsets ($\pm 5$\,cm), and per-log placement jitter ($\pm 4$\,cm lateral, $\pm 2$\,cm vertical)}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Clearing progression: fraction of 200-log pile cleared vs.\ grasp attempt number (mean $\pm $ std over 100 episodes). RL plateaus at $\sim $53\% while BC, BC+RL, and the heuristic all approach full clearing.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:clearing_curves}{{7}{9}{Clearing progression: fraction of 200-log pile cleared vs.\ grasp attempt number (mean $\pm $ std over 100 episodes). RL plateaus at $\sim $53\% while BC, BC+RL, and the heuristic all approach full clearing}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces BC+RL training sensitivity. Mean episode return vs.\ PPO iteration for four configurations varying encoder freezing and initial policy noise $\sigma _0$. Only the frozen-encoder, low-noise configuration ($\sigma _0 = 0.05$) sustains performance; all other variants collapse during training.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:bcrl_ablation}{{8}{9}{BC+RL training sensitivity. Mean episode return vs.\ PPO iteration for four configurations varying encoder freezing and initial policy noise $\sigma _0$. Only the frozen-encoder, low-noise configuration ($\sigma _0 = 0.05$) sustains performance; all other variants collapse during training}{figure.caption.10}{}}
